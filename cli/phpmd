#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: $0 <file1> <file2> ..."
  exit 1
fi

eval "$(./cli/get-git-files --php "$@")"

if [ "$FILES" == "" ]; then
  echo "Nenhum arquivo para verificar !"
  exit 0
fi

config=phpmd.xml

./bin/phpmd analyze --minimum-priority 4 --ruleset $config --format text --no-progress $FILES | sed 's|/var/www/html/||g'

exit ${PIPESTATUS[0]}
