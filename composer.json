{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-bundle": "^3.4.2",
    "doctrine/doctrine-migrations-bundle": "^4.0.1",
    "doctrine/orm": "^3.8",
    "phpdocumentor/reflection-docblock": "^5.6.7",
    "phpstan/phpdoc-parser": "^2.4.1",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/flex": "^2.12",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/intl": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/notifier": "7.4.*",
    "symfony/process": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/scheduler": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/string": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/web-link": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/extra-bundle": "^2.12|^3.29",
    "twig/twig": "^2.12|^3.30",
    "webmozart/assert": "^1.12"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3.1",
    "friendsofphp/php-cs-fixer": "^3.95.30",
    "jangregor/phpstan-prophecy": "^2.3",
    "phpmd/phpmd": "^3.0",
    "phpspec/prophecy": "^1.26.1",
    "phpspec/prophecy-phpunit": "^2.5",
    "phpstan/phpstan": "^2.3.6",
    "phpstan/phpstan-doctrine": "^2.1.2",
    "phpstan/phpstan-phpunit": "^2.1.2",
    "phpstan/phpstan-symfony": "^2.1.1",
    "phpstan/phpstan-webmozart-assert": "^2.0",
    "phpunit/phpunit": "^13.4.7",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/maker-bundle": "^1.68",
    "symfony/stopwatch": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/App",
      "Skeleton\\": "src/Skeleton"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*",
    "symfony/polyfill-php85": "*"
  },
  "scripts": {
    "auto-scripts": [],
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  }
}
